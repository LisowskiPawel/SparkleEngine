function(sparkle_parse_asset_pack_file source_file seen_source_files out_name out_bytes out_sha256)
    string(REPLACE "|" ";" _fields "${source_file}")
    list(LENGTH _fields _field_count)
    if(NOT _field_count EQUAL 3)
        message(FATAL_ERROR "Asset pack file manifest entry must be name|bytes|sha256: ${source_file}")
    endif()
    list(GET _fields 0 _file_name)
    list(GET _fields 1 _file_bytes)
    list(GET _fields 2 _file_sha256)
    if(NOT _file_name MATCHES "^[A-Za-z0-9][A-Za-z0-9_./-]*$" OR _file_name MATCHES "\\.\\."
       OR _file_name IN_LIST seen_source_files)
        message(FATAL_ERROR "Asset pack file manifest has an unsafe or duplicate name: ${_file_name}")
    endif()
    if(NOT _file_bytes MATCHES "^[0-9]+$" OR _file_bytes EQUAL 0)
        message(FATAL_ERROR "Asset pack file manifest has an invalid byte count: ${source_file}")
    endif()
    string(LENGTH "${_file_sha256}" _file_sha256_length)
    if(NOT _file_sha256_length EQUAL 64 OR NOT _file_sha256 MATCHES "^[0-9A-Fa-f]+$")
        message(FATAL_ERROR "Asset pack file manifest has an invalid SHA-256: ${source_file}")
    endif()
    cmake_path(NORMAL_PATH _file_name OUTPUT_VARIABLE _normalized_file_name)
    if(NOT _file_name STREQUAL _normalized_file_name)
        message(FATAL_ERROR "Asset pack file manifest has a non-canonical path: ${_file_name}")
    endif()
    set(${out_name} "${_file_name}" PARENT_SCOPE)
    set(${out_bytes} "${_file_bytes}" PARENT_SCOPE)
    set(${out_sha256} "${_file_sha256}" PARENT_SCOPE)
endfunction()

function(sparkle_download_asset_pack_file pack_id url staging_root root_relative file_name file_bytes file_sha256)
    set(_staged_file "${staging_root}/${root_relative}/${file_name}")
    get_filename_component(_staged_file_directory "${_staged_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_staged_file_directory}")
    message(STATUS "Downloading ${pack_id}/${file_name} (${file_bytes} bytes).")
    file(DOWNLOAD "${url}${file_name}" "${_staged_file}"
        SHOW_PROGRESS TLS_VERIFY ON INACTIVITY_TIMEOUT 180 TIMEOUT 21600 STATUS _download_status)
    list(GET _download_status 0 _download_code)
    list(GET _download_status 1 _download_message)
    if(NOT _download_code EQUAL 0)
        message(FATAL_ERROR "Failed to download ${pack_id}/${file_name}: ${_download_message}")
    endif()
    file(SIZE "${_staged_file}" _downloaded_bytes)
    file(SHA256 "${_staged_file}" _downloaded_sha256)
    string(TOLOWER "${file_sha256}" file_sha256)
    string(TOLOWER "${_downloaded_sha256}" _downloaded_sha256)
    if(NOT _downloaded_bytes EQUAL file_bytes OR NOT _downloaded_sha256 STREQUAL file_sha256)
        message(FATAL_ERROR "Downloaded ${pack_id}/${file_name} fails the pinned size or SHA-256 check.")
    endif()
endfunction()

function(sparkle_stage_asset_pack_files pack_id url manifest_path project_root staging_root root_relative out_hash)
    file(REAL_PATH "${project_root}" project_root_real)
    cmake_path(ABSOLUTE_PATH manifest_path NORMALIZE OUTPUT_VARIABLE _files_manifest)
    cmake_path(IS_PREFIX project_root "${_files_manifest}" NORMALIZE _manifest_is_project_owned)
    if(NOT _manifest_is_project_owned OR NOT EXISTS "${_files_manifest}")
        message(FATAL_ERROR "Asset pack file manifest is unavailable inside the project: ${_files_manifest}")
    endif()
    file(REAL_PATH "${_files_manifest}" _files_manifest_real)
    cmake_path(IS_PREFIX project_root_real "${_files_manifest_real}" NORMALIZE _manifest_real_is_project_owned)
    if(NOT _manifest_real_is_project_owned)
        message(FATAL_ERROR "Asset pack file manifest resolves outside the project: ${_files_manifest_real}")
    endif()

    file(STRINGS "${_files_manifest}" _source_files)
    if(NOT _source_files)
        message(FATAL_ERROR "Asset pack file manifest is empty: ${_files_manifest}")
    endif()
    file(REMOVE_RECURSE "${staging_root}")
    file(MAKE_DIRECTORY "${staging_root}/${root_relative}")
    set(_seen_source_files)
    foreach(_source_file IN LISTS _source_files)
        sparkle_parse_asset_pack_file("${_source_file}" "${_seen_source_files}" _name _bytes _sha256)
        list(APPEND _seen_source_files "${_name}")
        sparkle_download_asset_pack_file("${pack_id}" "${url}" "${staging_root}" "${root_relative}" "${_name}" "${_bytes}" "${_sha256}")
    endforeach()
    file(SHA256 "${_files_manifest}" _manifest_hash)
    set(${out_hash} "${_manifest_hash}" PARENT_SCOPE)
endfunction()
