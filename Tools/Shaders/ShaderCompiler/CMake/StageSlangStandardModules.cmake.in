cmake_minimum_required(VERSION 3.30)

# Generated from the same module enumeration as the toolchain/package inventory.
set(_module_names [==[@_shader_module_names@]==])
set(_module_files [==[@_shader_module_files@]==])

if(NOT IS_DIRECTORY "${SPARKLE_SLANG_MODULE_SOURCE_DIRECTORY}" OR
   NOT IS_DIRECTORY "${SPARKLE_RUNTIME_DIRECTORY}" OR
   IS_SYMLINK "${SPARKLE_RUNTIME_DIRECTORY}")
    message(FATAL_ERROR "Slang module staging requires an existing SDK source and a native runtime directory.")
endif()
file(REAL_PATH "${SPARKLE_SLANG_MODULE_SOURCE_DIRECTORY}" _source_root)
file(REAL_PATH "${SPARKLE_RUNTIME_DIRECTORY}" _runtime_root)
set(_source_key "${_source_root}")
set(_runtime_key "${_runtime_root}")
if(WIN32)
    string(TOLOWER "${_source_key}" _source_key)
    string(TOLOWER "${_runtime_key}" _runtime_key)
endif()
cmake_path(IS_PREFIX _source_key "${_runtime_key}" NORMALIZE _source_contains_runtime)
cmake_path(IS_PREFIX _runtime_key "${_source_key}" NORMALIZE _runtime_contains_source)
if(_source_contains_runtime OR _runtime_contains_source)
    message(FATAL_ERROR "Slang SDK source and runtime staging directories must not overlap.")
endif()

# Admit the complete source and existing destination tree before changing modules.
foreach(_module IN LISTS _module_names)
    if(NOT IS_DIRECTORY "${_source_root}/${_module}" OR IS_SYMLINK "${_source_root}/${_module}")
        message(FATAL_ERROR "Slang standard module is missing or linked: ${_source_root}/${_module}")
    endif()
endforeach()
foreach(_file IN LISTS _module_files)
    if(NOT EXISTS "${_source_root}/${_file}" OR IS_DIRECTORY "${_source_root}/${_file}" OR IS_SYMLINK "${_source_root}/${_file}")
        message(FATAL_ERROR "Slang module input is missing or linked: ${_source_root}/${_file}")
    endif()
endforeach()
file(GLOB _staged_modules LIST_DIRECTORIES true "${_runtime_root}/slang-standard-module-*")
set(_staged_entries)
foreach(_module IN LISTS _staged_modules)
    if(NOT IS_DIRECTORY "${_module}" OR IS_SYMLINK "${_module}")
        message(FATAL_ERROR "Slang staged module is not a native directory: ${_module}")
    endif()
    file(RELATIVE_PATH _module_name "${_runtime_root}" "${_module}")
    file(GLOB_RECURSE _entries LIST_DIRECTORIES true RELATIVE "${_runtime_root}" "${_module}/*")
    list(APPEND _staged_entries "${_module_name}" ${_entries})
endforeach()
foreach(_entry IN LISTS _staged_entries)
    if(IS_SYMLINK "${_runtime_root}/${_entry}")
        message(FATAL_ERROR "Slang staging cannot traverse a linked member: ${_runtime_root}/${_entry}")
    endif()
endforeach()

# Retire obsolete shapes before copying, including SDK file/directory changes.
# This private tool's slang-standard-module-* trees are SDK-owned. Other payload stays untouched.
set(_module_file_keys "${_module_files}")
set(_module_name_keys "${_module_names}")
if(WIN32)
    list(TRANSFORM _module_file_keys TOLOWER)
    list(TRANSFORM _module_name_keys TOLOWER)
endif()
list(SORT _staged_entries ORDER DESCENDING)
foreach(_entry IN LISTS _staged_entries)
    set(_entry_key "${_entry}")
    if(WIN32)
        string(TOLOWER "${_entry_key}" _entry_key)
    endif()
    set(_path "${_runtime_root}/${_entry}")
    if(IS_DIRECTORY "${_path}")
        file(GLOB _children LIST_DIRECTORIES true "${_path}/*")
        if(NOT _children AND NOT _entry_key IN_LIST _module_name_keys)
            file(REMOVE_RECURSE "${_path}")
            if(EXISTS "${_path}")
                message(FATAL_ERROR "Cannot prune an obsolete Slang module directory: ${_path}")
            endif()
        endif()
    elseif(NOT _entry_key IN_LIST _module_file_keys)
        file(REMOVE "${_path}")
        if(EXISTS "${_path}")
            message(FATAL_ERROR "Cannot prune an obsolete Slang module file: ${_path}")
        endif()
    endif()
endforeach()

foreach(_file IN LISTS _module_files)
    get_filename_component(_parent "${_runtime_root}/${_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(COPY_FILE "${_source_root}/${_file}" "${_runtime_root}/${_file}" ONLY_IF_DIFFERENT INPUT_MAY_BE_RECENT)
endforeach()

