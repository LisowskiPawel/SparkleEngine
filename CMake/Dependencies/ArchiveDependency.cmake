# Bind every extracted file to a verified archive, without rebuilding or rewriting it.
function(sparkle_archive_content_identity root_path archive_hash output_variable)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${root_path}" "${root_path}/*")
    list(REMOVE_ITEM files ".sparkle-archive.sha256")
    list(SORT files)
    set(identity "${archive_hash}\n")
    foreach(relative_path IN LISTS files)
        file(SHA256 "${root_path}/${relative_path}" content_hash)
        string(APPEND identity "${content_hash} ${relative_path}\n")
    endforeach()
    set(${output_variable} "${identity}" PARENT_SCOPE)
endfunction()

function(sparkle_ensure_archive_dependency)
    set(oneValueArgs DISPLAY_NAME URL ARCHIVE_PATH ROOT_PATH EXPECTED_HASH)
    cmake_parse_arguments(ARG "" "${oneValueArgs}" "REQUIRED_PATHS" ${ARGN})
    string(REGEX REPLACE "^SHA256=" "" archive_hash "${ARG_EXPECTED_HASH}")
    string(LENGTH "${archive_hash}" hash_length)
    if(NOT ARG_EXPECTED_HASH MATCHES "^SHA256=" OR NOT hash_length EQUAL 64 OR NOT archive_hash MATCHES "^[0-9A-Fa-f]+$")
        message(FATAL_ERROR "${ARG_DISPLAY_NAME} requires a pinned SHA-256 archive identity.")
    endif()
    string(TOLOWER "${archive_hash}" archive_hash)
    set_property(GLOBAL APPEND PROPERTY SPARKLE_ADMITTED_ARCHIVES "${ARG_ROOT_PATH}|${archive_hash}")
    get_filename_component(cache_root "${FETCHCONTENT_BASE_DIR}" ABSOLUTE)
    foreach(path IN ITEMS "${ARG_ROOT_PATH}" "${ARG_ARCHIVE_PATH}")
        get_filename_component(absolute_path "${path}" ABSOLUTE)
        cmake_path(IS_PREFIX cache_root "${absolute_path}" NORMALIZE inside_cache)
        if(NOT inside_cache OR absolute_path STREQUAL cache_root)
            message(FATAL_ERROR "${ARG_DISPLAY_NAME} archive paths must stay inside '${cache_root}'.")
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${cache_root}")
    file(LOCK "${cache_root}/.sparkle-archive.lock" GUARD FUNCTION TIMEOUT 30)
    set(receipt "${ARG_ROOT_PATH}/.sparkle-archive.sha256")
    if(EXISTS "${receipt}")
        file(READ "${receipt}" admitted_identity)
        sparkle_archive_content_identity("${ARG_ROOT_PATH}" "${archive_hash}" current_identity)
        sparkle_collect_missing_relative_paths("${ARG_ROOT_PATH}" missing_paths ${ARG_REQUIRED_PATHS})
        if(NOT admitted_identity STREQUAL current_identity OR missing_paths)
            message(FATAL_ERROR "${ARG_DISPLAY_NAME} extracted cache differs from its verified archive. Preserved '${ARG_ROOT_PATH}'; inspect it, then explicitly Clean and Sync this dependency.")
        endif()
        return()
    endif()

    if(EXISTS "${ARG_ARCHIVE_PATH}")
        file(SHA256 "${ARG_ARCHIVE_PATH}" cached_hash)
        if(NOT cached_hash STREQUAL archive_hash)
            message(FATAL_ERROR "${ARG_DISPLAY_NAME} archive fails its pinned SHA-256. Preserved '${ARG_ARCHIVE_PATH}' for inspection.")
        endif()
    else()
        set(download_path "${ARG_ARCHIVE_PATH}.download")
        if(EXISTS "${download_path}")
            file(SHA256 "${download_path}" download_hash)
            if(NOT download_hash STREQUAL archive_hash)
                message(FATAL_ERROR "${ARG_DISPLAY_NAME} has an incomplete or changed download. Preserved '${download_path}'; inspect it, then explicitly Clean and Sync.")
            endif()
        else()
            file(DOWNLOAD "${ARG_URL}" "${download_path}"
                EXPECTED_HASH "${ARG_EXPECTED_HASH}" STATUS download_status TLS_VERIFY ON SHOW_PROGRESS)
            list(GET download_status 0 download_code)
            list(GET download_status 1 download_message)
            if(NOT download_code EQUAL 0)
                message(FATAL_ERROR "Failed to download ${ARG_DISPLAY_NAME}: ${download_message}. Prior inputs and '${download_path}' are preserved.")
            endif()
        endif()
        file(RENAME "${download_path}" "${ARG_ARCHIVE_PATH}" NO_REPLACE)
    endif()

    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef staging_id)
    set(staging_path "${ARG_ROOT_PATH}.incoming-${staging_id}")
    cmake_path(IS_PREFIX cache_root "${staging_path}" NORMALIZE staging_inside_cache)
    if(NOT staging_inside_cache OR EXISTS "${staging_path}")
        message(FATAL_ERROR "${ARG_DISPLAY_NAME} needs a fresh staging directory inside its cache.")
    endif()
    file(MAKE_DIRECTORY "${staging_path}")
    file(ARCHIVE_EXTRACT INPUT "${ARG_ARCHIVE_PATH}" DESTINATION "${staging_path}")
    sparkle_collect_missing_relative_paths("${staging_path}" missing_paths ${ARG_REQUIRED_PATHS})
    if(missing_paths)
        message(FATAL_ERROR "${ARG_DISPLAY_NAME} archive is incomplete: ${missing_paths}. Preserved prior inputs and '${staging_path}'.")
    endif()
    sparkle_archive_content_identity("${staging_path}" "${archive_hash}" verified_identity)
    if(EXISTS "${ARG_ROOT_PATH}")
        # Adopt an older cache only if its complete bytes match the verified archive.
        sparkle_archive_content_identity("${ARG_ROOT_PATH}" "${archive_hash}" prior_identity)
        if(NOT prior_identity STREQUAL verified_identity)
            message(FATAL_ERROR "${ARG_DISPLAY_NAME} existing cache differs from its verified archive. Preserved '${ARG_ROOT_PATH}' and '${staging_path}'; inspect, then explicitly Clean and Sync this dependency.")
        endif()
        file(CONFIGURE OUTPUT "${receipt}" CONTENT "${verified_identity}" @ONLY)
        # This exact fresh directory was created and verified above, inside cache_root.
        file(REMOVE_RECURSE "${staging_path}")
    else()
        file(CONFIGURE OUTPUT "${staging_path}/.sparkle-archive.sha256" CONTENT "${verified_identity}" @ONLY)
        file(RENAME "${staging_path}" "${ARG_ROOT_PATH}" NO_REPLACE)
    endif()
endfunction()
