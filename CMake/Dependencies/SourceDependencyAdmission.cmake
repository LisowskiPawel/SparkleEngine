# This build prerequisite verifies existing inputs. It cannot acquire or repair them.
function(sparkle_configure_source_dependency_admission)
    set(script "cmake_minimum_required(VERSION 3.30)\nset(GIT_EXECUTABLE [==[${GIT_EXECUTABLE}]==])\nset(FETCHCONTENT_BASE_DIR [==[${FETCHCONTENT_BASE_DIR}]==])\ninclude([==[${SPARKLE_REPOSITORY_ROOT}/CMake/Dependencies/DependencyCache.cmake]==])\n")
    get_property(dependencies GLOBAL PROPERTY SPARKLE_ADMITTED_GIT_DEPENDENCIES)
    list(REMOVE_DUPLICATES dependencies)
    foreach(dependency IN LISTS dependencies)
        get_property(id GLOBAL PROPERTY SPARKLE_GIT_DEPENDENCY_${dependency}_ID)
        get_property(revision GLOBAL PROPERTY SPARKLE_SOURCE_DEPENDENCY_${id}_REVISION)
        get_property(required GLOBAL PROPERTY SPARKLE_SOURCE_DEPENDENCY_${id}_REQUIRED_PATHS)
        set(root "${FETCHCONTENT_BASE_DIR}/${dependency}-src")
        string(APPEND script "if(NOT IS_DIRECTORY [==[${root}]==])\n    message(FATAL_ERROR [==[Missing prepared ${id} source. Run explicit Sync; builds do not fetch it.]==])\nendif()\nsparkle_prepare_git_fetchcontent_source(${dependency} EXPECTED_REVISION ${revision} REQUIRED_PATHS ${required})\n")
    endforeach()
    get_property(files GLOBAL PROPERTY SPARKLE_ADMITTED_SOURCE_FILES)
    list(REMOVE_DUPLICATES files)
    foreach(entry IN LISTS files)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 hash)
        list(GET fields 1 path)
        string(APPEND script "file(SHA256 [==[${path}]==] hash)\nif(NOT hash STREQUAL [==[${hash}]==])\n    message(FATAL_ERROR [==[Prepared source asset differs: ${path}. Inspect it, then explicitly Clean/Sync.]==])\nendif()\n")
    endforeach()
    get_property(archives GLOBAL PROPERTY SPARKLE_ADMITTED_ARCHIVES)
    list(REMOVE_DUPLICATES archives)
    foreach(entry IN LISTS archives)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 root)
        list(GET fields 1 hash)
        string(APPEND script "if(NOT EXISTS [==[${root}/.sparkle-archive.sha256]==])\n    message(FATAL_ERROR [==[Missing verified archive receipt: ${root}. Run explicit Sync.]==])\nendif()\nfile(READ [==[${root}/.sparkle-archive.sha256]==] admitted)\nsparkle_archive_content_identity([==[${root}]==] ${hash} observed)\nif(NOT admitted STREQUAL observed)\n    message(FATAL_ERROR [==[Prepared archive changed: ${root}. Inspect it, then explicitly Clean/Sync.]==])\nendif()\n")
    endforeach()
    set(path "${CMAKE_BINARY_DIR}/private/SourceDependencyAdmission.cmake")
    file(CONFIGURE OUTPUT "${path}" CONTENT "${script}" @ONLY)
    add_custom_target(SparkleSourceDependenciesReady
        COMMAND "${SPARKLE_POWERSHELL_EXECUTABLE}" -NoProfile -ExecutionPolicy Bypass
            -File "${SPARKLE_REPOSITORY_ROOT}/CMake/Dependencies/SourceCacheRead.ps1"
            "${SPARKLE_SOURCE_CACHE_LOCK_FILE}" "${CMAKE_COMMAND}" -P "${path}"
        VERBATIM)
    set_target_properties(SparkleSourceDependenciesReady PROPERTIES FOLDER "ThirdParty")
endfunction()
