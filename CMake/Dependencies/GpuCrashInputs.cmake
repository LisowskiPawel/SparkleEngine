include_guard(GLOBAL)

# File identity only. This does not load the SDK or qualify native compatibility.
function(sparkle_verify_gpu_crash_inputs sdk_root input_group)
    if(NOT IS_ABSOLUTE "${sdk_root}" OR NOT IS_DIRECTORY "${sdk_root}")
        message(FATAL_ERROR "${input_group} requires an explicit absolute SDK root.")
    endif()

    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/GpuCrashInputs.json" _receipt)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/GpuCrashInputs.json")
    string(JSON _file_count LENGTH "${_receipt}" "${input_group}" files)
    math(EXPR _last_file "${_file_count} - 1")
    set(_expected_files)
    foreach(_index RANGE ${_last_file})
        string(JSON _relative GET "${_receipt}" "${input_group}" files ${_index} path)
        string(JSON _expected_hash GET "${_receipt}" "${input_group}" files ${_index} sha256)
        set(_input "${sdk_root}/${_relative}")
        if(NOT EXISTS "${_input}" OR IS_DIRECTORY "${_input}")
            message(FATAL_ERROR "Missing ${input_group} input: ${_relative}")
        endif()
        file(SHA256 "${_input}" _actual_hash)
        if(NOT _actual_hash STREQUAL _expected_hash)
            message(FATAL_ERROR "Unqualified ${input_group} input: ${_relative}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_input}")
        list(APPEND _expected_files "${_relative}")
        if(input_group STREQUAL "Aftermath" AND _relative STREQUAL "lib/x64/GFSDK_Aftermath_Lib.x64.dll")
            set(SPARKLE_AFTERMATH_RUNTIME_SHA256 "${_expected_hash}" PARENT_SCOPE)
        endif()
    endforeach()

    string(JSON _directory_count LENGTH "${_receipt}" "${input_group}" directories)
    math(EXPR _last_directory "${_directory_count} - 1")
    foreach(_index RANGE ${_last_directory})
        string(JSON _directory GET "${_receipt}" "${input_group}" directories ${_index})
        file(GLOB_RECURSE _actual_files LIST_DIRECTORIES false RELATIVE "${sdk_root}" "${sdk_root}/${_directory}/*")
        foreach(_relative IN LISTS _actual_files)
            if(NOT _relative IN_LIST _expected_files)
                message(FATAL_ERROR "Unqualified ${input_group} input: ${_relative}")
            endif()
        endforeach()
    endforeach()
endfunction()
