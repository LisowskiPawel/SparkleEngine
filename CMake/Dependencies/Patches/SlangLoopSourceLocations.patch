+    void emitLoopSourceLocation(IRLoop* loopInst, SpvInstParent* parent)
+    {
+        auto debugLevel = m_targetProgram->getOptionSet().getDebugInfoLevel();
+        auto location = loopInst->findDecoration<IRDebugLocationDecoration>();
+        if (debugLevel == DebugInfoLevel::None || !location)
+            return;
+
+        if (debugLevel == DebugInfoLevel::Minimal)
+        {
+            auto source = as<IRDebugSource>(location->getSource());
+            auto line = as<IRIntLit>(location->getLine())->getValue();
+            auto col = as<IRIntLit>(location->getCol())->getValue();
+            emitInst(
+                parent,
+                nullptr,
+                SpvOpLine,
+                source->getFileName(),
+                SpvLiteralInteger::from32((uint32_t)line),
+                SpvLiteralInteger::from32((uint32_t)col));
+            return;
+        }
+
+        emitOpDebugLine(
+            parent,
+            nullptr,
+            m_voidType,
+            getNonSemanticDebugInfoExtInst(),
+            location->getSource(),
+            location->getLine(),
+            location->getLine(),
+            location->getCol(),
+            location->getCol());
+    }
+
     void emitLoopHeaderBlock(IRLoop* loopInst, SpvInst* loopHeaderBlock)
     {
+        // Phi nodes are already emitted; line metadata must follow them.
+        emitLoopSourceLocation(loopInst, loopHeaderBlock);
+
         bool hasBackJump = false;
         for (auto use = loopInst->getTargetBlock()->firstUse; use; use = use->nextUse)
         {
