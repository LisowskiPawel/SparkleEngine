# Prefer explicit kit paths, then discover installed Windows MSVC x64 kits.
set(SPARKLE_QT_ROOT "" CACHE PATH "Qt kit root used by Sparkle, for example a Qt MSVC x64 kit root.")

function(sparkle_normalize_qt_candidate candidate_path output_variable)
    set(${output_variable} "" PARENT_SCOPE)
    if(candidate_path STREQUAL "")
        return()
    endif()
    cmake_path(NORMAL_PATH candidate_path OUTPUT_VARIABLE normalized_candidate)
    get_filename_component(candidate_name "${normalized_candidate}" NAME)
    string(TOLOWER "${candidate_name}" candidate_name_lower)
    if(candidate_name_lower STREQUAL "qt6")
        get_filename_component(normalized_candidate "${normalized_candidate}/../../.." ABSOLUTE)
        get_filename_component(candidate_name "${normalized_candidate}" NAME)
        string(TOLOWER "${candidate_name}" candidate_name_lower)
    endif()
    if(NOT EXISTS "${normalized_candidate}/lib/cmake/Qt6/Qt6Config.cmake")
        return()
    endif()
    if(WIN32 AND (NOT candidate_name_lower MATCHES "msvc.*64" OR candidate_name_lower MATCHES "arm64"))
        return()
    endif()
    set(${output_variable} "${normalized_candidate}" PARENT_SCOPE)
endfunction()

function(sparkle_discover_qt_kit)
    if(Qt6_DIR)
        return()
    endif()
    set(_candidates "${SPARKLE_QT_ROOT}")
    foreach(_variable IN ITEMS SPARKLE_QT_ROOT QTDIR Qt6_DIR)
        if(DEFINED ENV{${_variable}})
            list(APPEND _candidates "$ENV{${_variable}}")
        endif()
    endforeach()
    if(WIN32 AND IS_DIRECTORY "C:/Qt")
        file(GLOB _version_roots LIST_DIRECTORIES TRUE "C:/Qt/*")
        list(SORT _version_roots COMPARE NATURAL ORDER DESCENDING)
        foreach(_version_root IN LISTS _version_roots)
            file(GLOB _kit_roots LIST_DIRECTORIES TRUE "${_version_root}/msvc*64")
            list(SORT _kit_roots ORDER DESCENDING)
            list(APPEND _candidates ${_kit_roots})
        endforeach()
    endif()
    foreach(_candidate IN LISTS _candidates)
        sparkle_normalize_qt_candidate("${_candidate}" _kit_root)
        if(_kit_root AND NOT _kit_root IN_LIST CMAKE_PREFIX_PATH)
            list(APPEND CMAKE_PREFIX_PATH "${_kit_root}")
            message(STATUS "Sparkle Qt kit discovered: ${_kit_root}")
        endif()
    endforeach()
    set(CMAKE_PREFIX_PATH "${CMAKE_PREFIX_PATH}" CACHE STRING "CMake package prefix paths." FORCE)
    set(CMAKE_PREFIX_PATH "${CMAKE_PREFIX_PATH}" PARENT_SCOPE)
endfunction()

sparkle_discover_qt_kit()
