#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SPARKLE_VERSION_COMPONENTS@,0
 PRODUCTVERSION @SPARKLE_VERSION_COMPONENTS@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@SPARKLE_PUBLISHER@\0"
            VALUE "FileDescription", "@SPARKLE_PRODUCT_NAME@\0"
            VALUE "FileVersion", "@SPARKLE_VERSION@\0"
            VALUE "InternalName", "@SPARKLE_PRODUCT_EXECUTABLE@\0"
            VALUE "LegalCopyright", "@SPARKLE_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@SPARKLE_PRODUCT_EXECUTABLE@\0"
            VALUE "ProductName", "@SPARKLE_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@SPARKLE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
