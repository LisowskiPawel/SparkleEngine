option(ENABLE_SANITIZERS "Enable sanitizer instrumentation (requires Clang or GCC)" OFF)
set(SANITIZER_TYPE "ASAN" CACHE STRING "Sanitizer to enable: ASAN, UBSAN, TSAN, MSAN, LSAN")
set_property(CACHE SANITIZER_TYPE PROPERTY STRINGS ASAN UBSAN TSAN MSAN LSAN)
if(NOT ENABLE_SANITIZERS)
    return()
endif()

if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    message(FATAL_ERROR "ENABLE_SANITIZERS requires Clang or GCC; selected compiler: ${CMAKE_CXX_COMPILER_ID}")
endif()

if(SANITIZER_TYPE STREQUAL "ASAN")
    set(_sparkle_sanitizer address,leak)
elseif(SANITIZER_TYPE STREQUAL "UBSAN")
    set(_sparkle_sanitizer undefined)
    add_compile_options(-fno-sanitize-recover=undefined)
elseif(SANITIZER_TYPE STREQUAL "TSAN")
    set(_sparkle_sanitizer thread)
elseif(SANITIZER_TYPE STREQUAL "MSAN")
    set(_sparkle_sanitizer memory)
elseif(SANITIZER_TYPE STREQUAL "LSAN")
    set(_sparkle_sanitizer leak)
else()
    message(FATAL_ERROR "Unknown SANITIZER_TYPE: ${SANITIZER_TYPE}")
endif()

add_compile_options("-fsanitize=${_sparkle_sanitizer}" -fno-omit-frame-pointer -g -O1)
add_link_options("-fsanitize=${_sparkle_sanitizer}")
