cmake_minimum_required(VERSION 3.27)
include("${SPARKLE_RUNTIME_MANIFEST}")
list(FILTER SPARKLE_RUNTIME_FILES EXCLUDE REGEX "^$")
if(IS_SYMLINK "${SPARKLE_RUNTIME_DIRECTORY}")
    message(FATAL_ERROR "Runtime staging requires a native product directory.")
endif()
file(MAKE_DIRECTORY "${SPARKLE_RUNTIME_DIRECTORY}")
file(REAL_PATH "${SPARKLE_RUNTIME_DIRECTORY}" runtime_root)
set(sources)
set(current_files)
foreach(entry IN LISTS SPARKLE_RUNTIME_FILES)
    if(entry MATCHES "^(.+)\\|(.+)$")
        set(source "${CMAKE_MATCH_1}")
        set(relative_path "${CMAKE_MATCH_2}")
    else()
        set(source "${entry}")
        cmake_path(GET source FILENAME relative_path)
    endif()
    if(IS_ABSOLUTE "${relative_path}" OR relative_path MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
        message(FATAL_ERROR "Runtime staging path escapes its product: '${relative_path}'.")
    endif()
    set(existing_destination "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}")
    while(NOT EXISTS "${existing_destination}")
        get_filename_component(existing_destination "${existing_destination}" DIRECTORY)
    endwhile()
    file(REAL_PATH "${existing_destination}" destination_path)
    cmake_path(IS_PREFIX runtime_root "${destination_path}" NORMALIZE destination_inside_root)
    if(NOT destination_inside_root OR IS_SYMLINK "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}")
        message(FATAL_ERROR "Runtime staging cannot follow a linked destination '${relative_path}'.")
    endif()
    if(relative_path IN_LIST current_files)
        list(FIND current_files "${relative_path}" existing_index)
        list(GET sources ${existing_index} existing_source)
        if(NOT existing_source STREQUAL source)
            message(FATAL_ERROR "Ambiguous runtime sources for '${relative_path}'.")
        endif()
    endif()
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Missing runtime input '${source}'. Prior runtime files are preserved.")
    endif()
    list(APPEND sources "${source}")
    list(APPEND current_files "${relative_path}")
endforeach()

set(previous_files ${SPARKLE_RUNTIME_STALE_FILES})
if(EXISTS "${SPARKLE_RUNTIME_RECORD}")
    file(STRINGS "${SPARKLE_RUNTIME_RECORD}" recorded_files ENCODING UTF-8)
    list(APPEND previous_files ${recorded_files})
endif()
list(REMOVE_DUPLICATES previous_files)
foreach(relative_path IN LISTS previous_files)
    if(IS_ABSOLUTE "${relative_path}" OR relative_path MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
        message(FATAL_ERROR "Invalid prior runtime ownership path '${relative_path}'.")
    endif()
    set(existing_prior "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}")
    while(NOT EXISTS "${existing_prior}")
        get_filename_component(existing_prior "${existing_prior}" DIRECTORY)
    endwhile()
    file(REAL_PATH "${existing_prior}" prior_path)
    cmake_path(IS_PREFIX runtime_root "${prior_path}" NORMALIZE prior_inside_root)
    if(NOT prior_inside_root OR IS_SYMLINK "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}")
        message(FATAL_ERROR "Runtime staging cannot retire a linked destination '${relative_path}'.")
    endif()
endforeach()

# Admit the complete source/ownership set before updating any product file.
foreach(source relative_path IN ZIP_LISTS sources current_files)
    get_filename_component(destination_directory "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}" DIRECTORY)
    file(MAKE_DIRECTORY "${destination_directory}")
    file(COPY_FILE "${source}" "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}" ONLY_IF_DIFFERENT INPUT_MAY_BE_RECENT)
endforeach()
foreach(relative_path IN LISTS previous_files)
    if(NOT relative_path IN_LIST current_files AND NOT relative_path IN_LIST SPARKLE_RUNTIME_PRESERVE_FILES)
        file(REMOVE "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}")
        if(EXISTS "${SPARKLE_RUNTIME_DIRECTORY}/${relative_path}")
            message(FATAL_ERROR "Cannot retire obsolete runtime file '${relative_path}'.")
        endif()
    endif()
endforeach()
list(REMOVE_DUPLICATES current_files)
list(SORT current_files)
list(JOIN current_files "\n" record)
file(CONFIGURE OUTPUT "${SPARKLE_RUNTIME_RECORD}" CONTENT "${record}\n" @ONLY)
