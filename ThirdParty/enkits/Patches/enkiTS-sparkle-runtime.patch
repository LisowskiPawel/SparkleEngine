+    if( error_ && errorCapacity_ )
+    {
+        error_[0] = '\0';
+    }
+    const char* message = "enkiTS initialization failed";
+    try
+    {
+        enkiInitTaskSchedulerWithConfig( pETS_, config_ );
+        return 1;
+    }
+    catch( const std::exception& error )
+    {
+        if( error_ && errorCapacity_ )
+        {
+            const size_t count = std::min( std::strlen(error.what()), errorCapacity_ - 1 );
+            std::memcpy( error_, error.what(), count );
+            error_[count] = '\0';
+        }
+        return 0;
+    }
+    catch( ... )
+    {
+        if( error_ && errorCapacity_ )
+        {
+            const size_t count = std::min( std::strlen(message), errorCapacity_ - 1 );
+            std::memcpy( error_, message, count );
+            error_[count] = '\0';
+        }
