function(sparkle_materialize_enkits_source source)
    file(RELATIVE_PATH relative_source "${SPARKLE_REPOSITORY_ROOT}" "${source}")
    if(IS_ABSOLUTE "${relative_source}" OR relative_source MATCHES "^\\.\\.([/\\\\]|$)")
        message(FATAL_ERROR "enkiTS derived source escapes the workspace: '${source}'.")
    endif()
    foreach(file IN LISTS SPARKLE_ENKITS_REQUIRED_PATHS)
        file(READ "${enkits_SOURCE_DIR}/${file}" contents)
        string(REPLACE "\r\n" "\n" contents "${contents}")
        get_filename_component(directory "${source}/${file}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${source}/${file}" "${contents}")
    endforeach()

    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "--directory=${relative_source}" "${_sparkle_enkits_patch}"
        WORKING_DIRECTORY "${SPARKLE_REPOSITORY_ROOT}" RESULT_VARIABLE patch_check ERROR_VARIABLE patch_error)
    if(NOT patch_check EQUAL 0)
        message(FATAL_ERROR "enkiTS patch cannot apply to derived sources: ${patch_error}. Sources preserved.")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "--directory=${relative_source}" "${_sparkle_enkits_patch}"
        WORKING_DIRECTORY "${SPARKLE_REPOSITORY_ROOT}" RESULT_VARIABLE patch_result ERROR_VARIABLE patch_error)
    if(NOT patch_result EQUAL 0)
        message(FATAL_ERROR "enkiTS patch failed: ${patch_error}. Sources preserved.")
    endif()
endfunction()

function(sparkle_validate_enkits_source source)
    file(GLOB_RECURSE actual_files LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
    set(expected_files ${SPARKLE_ENKITS_REQUIRED_PATHS})
    list(SORT actual_files)
    list(SORT expected_files)
    if(NOT actual_files STREQUAL expected_files)
        message(FATAL_ERROR "enkiTS derived sources are incomplete or contain extra files. Preserved '${source}'; clean this owned variant build and retry.")
    endif()
    foreach(file IN LISTS expected_files)
        if(IS_SYMLINK "${source}/${file}")
            message(FATAL_ERROR "enkiTS derived file is a link: '${source}/${file}'.")
        endif()
        # Reconstruct qualified Windows bytes independently of Git checkout policy.
        file(READ "${enkits_SOURCE_DIR}/${file}" contents)
        string(REPLACE "\r\n" "\n" contents "${contents}")
        string(REPLACE "\n" "\r\n" windows_contents "${contents}")
        string(SHA256 expected_hash "${windows_contents}")
        if(file STREQUAL "src/TaskScheduler.cpp")
            set(expected_hash "ca734db4fe54f5f13702b1c4c6103aa0c5fe42b6948fe77506fadae1f0987373")
        elseif(file STREQUAL "src/TaskScheduler_c.cpp")
            set(expected_hash "5388245a1a6054260b6786558a5f9813c63c0c1c375f42e6f12f1c4a9e53d820")
        elseif(file STREQUAL "src/TaskScheduler_c.h")
            set(expected_hash "6269a524d48c21c741c0c92fb06675beb81b7f015881c727e58c1a5add50c1a3")
        endif()
        file(SHA256 "${source}/${file}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "enkiTS derived source differs from the qualified bytes: '${source}/${file}'. Source preserved.")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${enkits_SOURCE_DIR}/${file}" "${source}/${file}")
    endforeach()
endfunction()

function(sparkle_prepare_enkits_source source)
    if(IS_SYMLINK "${source}" OR IS_SYMLINK "${source}/src")
        message(FATAL_ERROR "enkiTS derived source must be an owned directory, not a link: '${source}'.")
    endif()
    if(NOT EXISTS "${source}")
        sparkle_materialize_enkits_source("${source}")
    endif()
    sparkle_validate_enkits_source("${source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_sparkle_enkits_patch}")
endfunction()
